      },
      {
        "title": "内容整理者",
        "open": false,
        "rows": [
          {
            "title": "识别特征",
            "body": "了解资料的阅读对象与使用场景。"
          },
          {
            "title": "协作方式",
            "body": "组织章节与字段，列出待核对项。"
          }
        ]
      },
      {
        "title": "使用者",
        "open": false,
        "rows": [
          {
            "title": "识别特征",
            "body": "需要从资料中查找信息或执行操作。"
          },
          {
            "title": "协作方式",
            "body": "按实际任务检验内容，反馈难以理解的地方。"
          }
        ]
      },
      {
        "title": "维护者",
        "open": false,
        "rows": [
          {
            "title": "识别特征",
            "body": "负责资料版本与附件的后续更新。"
          },
          {
            "title": "协作方式",
            "body": "确认内容变动后更新资料日期并保留前版。"
          }
        ]
      }
    ]
