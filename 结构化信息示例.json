  "fields": {
    "t": "number_folds",
    "layout": "fields",
    "title": "资料角色说明（演示）",
    "items": [
      {
        "title": "内容提供者",
        "open": true,
        "rows": [
          {
            "title": "识别特征",
            "body": "掌握原始事实、数据与素材。"
          },
          {
            "title": "协作方式",
            "body": "提供原稿和必要说明，确认实质信息。"
          }
